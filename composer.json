{
    "name": "murkrow/laravel-rag",
    "description": "Generic, configuration-driven RAG toolkit for Laravel: chunking, embeddings, pgvector retrieval, grounded answering, an MCP server and a Filament control panel.",
    "keywords": [
        "laravel",
        "rag",
        "llm",
        "embeddings",
        "pgvector",
        "mcp",
        "filament",
        "vector-search"
    ],
    "homepage": "https://github.com/Murkrow02/laravel-rag",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Coppola"
        }
    ],
    "support": {
        "issues": "https://github.com/Murkrow02/laravel-rag/issues",
        "source": "https://github.com/Murkrow02/laravel-rag"
    },
    "require": {
        "php": "^8.2",
        "illuminate/bus": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/session": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "pgvector/pgvector": "^0.2",
        "prism-php/prism": "^0.100"
    },
    "require-dev": {
        "filament/filament": "^4.0",
        "laravel/mcp": "^1.0@beta",
        "laravel/scout": "^10.4",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "suggest": {
        "filament/filament": "Required for the RAG control panel (dashboard, ingestion form, playground).",
        "laravel/mcp": "Required to expose the knowledge base to MCP clients.",
        "laravel/scout": "Enables the 'scout' hybrid lexical retrieval driver.",
        "yethee/tiktoken": "Enables exact BPE token counting instead of the heuristic estimator."
    },
    "autoload": {
        "psr-4": {
            "Murkrow\\Rag\\": "src/",
            "Murkrow\\Rag\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Murkrow\\Rag\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:pgvector": "pest --testsuite=Pgvector"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Murkrow\\Rag\\RagServiceProvider"
            ],
            "aliases": {
                "Rag": "Murkrow\\Rag\\Facades\\Rag"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
